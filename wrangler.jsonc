// Pengaturan hosting di Cloudflare Workers (paket gratis). Situs dibangun dengan adapter OpenNext:
//   npm run preview  → coba versi Cloudflare di komputer sendiri
//   npm run deploy   → bangun & unggah ke Cloudflare
// Hentikan `npm run dev` dulu sebelum menjalankan keduanya (sama-sama memakai folder .next).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webkeun",
  // cloudflare-worker.mjs meneruskan semua permintaan ke Worker OpenNext (.open-next/worker.js) dan menambah cache foto
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // File statis (JS, CSS, foto, musik, dan halaman yang sudah jadi saat build) disajikan langsung oleh Cloudflare:
  // gratis & tidak dihitung kuota permintaan
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Pengecil foto next/image lewat Cloudflare Images (paket gratis: 5.000 ukuran foto berbeda per bulan)
  "images": { "binding": "IMAGES" },
  // Anti-spam buku tamu: maksimal 5 ucapan per menit dari satu alamat IP (dipakai src/lib/batas.ts)
  "ratelimits": [{ "name": "BATAS_UCAPAN", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true },
}
